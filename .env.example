# Строка подключения к PostgreSQL
DATABASE_URL=postgres://notification:notification@localhost:5432/notification?sslmode=disable

# Адрес Redis
REDIS_URL=redis://localhost:6379/0

# Список брокеров Kafka через запятую
KAFKA_BROKERS=localhost:9092

# Порт gRPC-сервера
GRPC_PORT=50051

# Порт HTTP-сервера (/metrics и /health)
HTTP_PORT=8080

# Лимит уведомлений на одного пользователя в час
RATE_LIMIT_PER_HOUR=10